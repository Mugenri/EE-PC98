#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Spell 12"]
#System["./../../system/System.dnh"]

#include "./lib_Gengetsu.dnh"

int _objBoss;
int _count = -30;
int _loopTime = 330;
_spellID = 11;

@Event {
    alternative (GetEventType())
    case (EV_REQUEST_LIFE) {
        SetScriptResult(3800);
    }
    case (EV_REQUEST_TIMER) {
        SetScriptResult(40 + absolute(_count / 60));
    }
}

@Initialize {
    Boss_Init(false);
    _objBoss = Boss_Create(BOSS_ID_GENGETSU);
    TInitialize();
    TFinalize();
    TMain();
}

@MainLoop {
    Boss_Update(_objBoss);
    _count++;
    yield;
}

task TInitialize() {
    Gengetsu_Init(_objBoss);
    if (GetGameMode() == GAME_SPELL) Gengetsu_Move(_objBoss, MID_X, 90, 30);
    wait(30);
    Boss_SetVulnerable(_objBoss, true);
    TRage();
    TSpell();
}

task TFinalize() {
    while (Boss_Alive(_objBoss)) yield;
    Gengetsu_Move(_objBoss, MID_X, 60, 60);
    Animation_Charge(_objBoss, false);
    Boss_Finalize(_objBoss);
}

task TMain() {
    while (_count < -30) yield;
    while (Boss_Alive(_objBoss)) {
        if (!_isInvuln) Boss_SetIntersection(_objBoss, _intersectionShot, 0);
        yield;
    }
}

task TSpell() {
    WashingMachine(1);
    WashingMachine(-1);
    if (!Boss_Alive(_objBoss)) return;
    Gengetsu_Move(_objBoss, MID_X, 180, 60);
    wait(60);
    Phase3();

    function<void> WashingMachine(int dir_) {
        if (!Boss_Alive(_objBoss)) return;
        Animation_Charge(_objBoss, true);
        CallSFX(SND_CHARGE1);
        TChargeAnim();
        wait(30);
        if (!Boss_Alive(_objBoss)) return;

        //1 is blue
        //2 is red
        int way1 = 10;
        int way2 = 4;
        float speed1 = 3.3;
        float speed2 = 3.3;
        float angle1 = rand(0,360);
        float angle2 = rand(0,360);
        float inc1 = 8;
        float inc2 = 6.5;
        float wVel = 3;
        int waitTime = 7;

        loop (40) {
            if (!Boss_Alive(_objBoss)) return;
            for (int i = 0; i < way1; i++) { //blue
                int shot = CreateShotUA2(MID_X, 90, speed1, angle1, 0, speed1, wVel * dir_, SHOT_PINK+RING_S, 0, SHOT_PINK+SPAWN_S+SIZE_16, SHOT_PINK+CANCEL_BURST2);
                ObjMove_AddPatternA2(shot, 60, NO_CHANGE, NO_CHANGE, NO_CHANGE, NO_CHANGE, 0);
                angle1 += 360 / way1;
            }

            for (int i = 0; i < way2; i++) { //red
                CreateShotUA2(MID_X, 90, speed2, angle2 + 22.5, 0, speed1, 0, SHOT_RED_INV+BALL_S, 0, SHOT_RED_INV+SPAWN_S+SIZE_16, SHOT_RED_INV+CANCEL_FADE);
                CreateShotUA2(MID_X, 90, speed2, -angle2 + 22.5, 0, speed1, 0, SHOT_RED_INV+BALL_S, 0, SHOT_RED_INV+SPAWN_S+SIZE_16, SHOT_RED_INV+CANCEL_FADE);
                angle2 += 360 / way2;
            }
            angle1 -= inc1 * dir_;
            angle2 += inc2;
            CallSFX(SND_SHOT2);
            wait(waitTime);
        }
        Animation_Charge(_objBoss, false);
    }

    function<void> Phase3() {
        if (!Boss_Alive(_objBoss)) return;
        Animation_Charge(_objBoss, true);
        CallSFX(SND_CHARGE1);
        TChargeAnim2();
        wait(30);
        if (!Boss_Alive(_objBoss)) return;

        //12 second nightmare

        int stack = 5;
        float speed = 4;
        float angleT = rand(0, 360);
        float accel = 0.2;
        float waitTime = 10;
        int way = 0;

        loop {
            if (!Boss_Alive(_objBoss)) return;
            if (waitTime > 2) angleT = rand(0, 360);
            else angleT += 90 / way - 0.2;
            way = max(12 - waitTime, 6);
            for (int i = 0; i < way; i++) {
                CreateShotUA2(MID_X, 180, 0, angleT, accel, speed, 0, SHOT_RED+SWORD, 0, SHOT_RED+SPAWN_E+SIZE_16, SHOT_RED+CANCEL_BURST2);
                angleT += 360 / way;
            }
            CallSFX(SND_SHOT1);
            wait(waitTime);
            waitTime = max(1, waitTime - 0.2);
            if (waitTime == 1) accel = 0.10;
        }
    }
}

task TChargeAnim() {
    Primitive_ContractPolygon2D(_objBoss, 0, 368, 0, 45, 32, COLOR_WHITE, false, RP_STG_EFF_MID);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_WHITE);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_WHITE);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_PINK);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_PINK);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_PURPLE_L);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_PURPLE_L);
}

task TChargeAnim2() {
    Primitive_ContractPolygon2D(_objBoss, 0, 368, 0, 45, 32, COLOR_WHITE, false, RP_STG_EFF_MID);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 24, COLOR_PINK);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 24, COLOR_PINK);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 24, COLOR_RED_L);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 24, COLOR_RED_L);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 24, COLOR_RED_D);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 24, COLOR_RED_D);

    wait(200);
    if (!Boss_Alive(_objBoss)) return;
    CallSFX(SND_CHARGE2);
    Primitive_ContractPolygon2D(_objBoss, 0, 368, 0, 45, 32, COLOR_WHITE, false, RP_STG_EFF_MID);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 24, COLOR_PINK);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 24, COLOR_PINK);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 24, COLOR_RED_L);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 24, COLOR_RED_L);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 24, COLOR_RED_D);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 24, COLOR_RED_D);
}