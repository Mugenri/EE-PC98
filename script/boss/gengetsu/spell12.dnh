#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Spell 12"]
#System["./../../system/System.dnh"]

#include "./lib_Gengetsu.dnh"

int _objBoss;
int _count = -30;
int _loopTime = 330;
_spellID = 11;

@Event {
    alternative (GetEventType())
    case (EV_REQUEST_LIFE) {
        SetScriptResult(3500);
    }
    case (EV_REQUEST_TIMER) {
        SetScriptResult(35 + absolute(_count / 60));
    }
}

@Initialize {
    Boss_Init(false);
    _objBoss = Boss_Create(BOSS_ID_GENGETSU);
    TInitialize();
    TFinalize();
    TMain();
}

@MainLoop {
    Boss_Update(_objBoss);
    _count++;
    yield;
}

task TInitialize() {
    Gengetsu_Init(_objBoss);
    if (GetGameMode() == GAME_SPELL) Gengetsu_Move(_objBoss, MID_X, 90, 30);
    wait(30);
    Boss_SetVulnerable(_objBoss, true);
    TRage();
    TSpell();
}

task TFinalize() {
    while (Boss_Alive(_objBoss)) yield;
    Gengetsu_Move(_objBoss, MID_X, 60, 60);
    Animation_Charge(_objBoss, false);
    Boss_Finalize(_objBoss);
}

task TMain() {
    while (_count < -30) yield;
    while (Boss_Alive(_objBoss)) {
        if (!_isInvuln) Boss_SetIntersection(_objBoss, _intersectionShot, 0);
        yield;
    }
}

task TSpell() {
    Phase1();
    Phase2();
    if (!Boss_Alive(_objBoss)) return;
    Gengetsu_Move(_objBoss, MID_X, 180, 60);
    wait(60);
    Phase3();

    function<void> Phase1() {
        if (!Boss_Alive(_objBoss)) return;
        Animation_Charge(_objBoss, true);
        CallSFX(SND_CHARGE1);
        TChargeAnim();
        wait(30);
        if (!Boss_Alive(_objBoss)) return;

        int way = 7;
        int stack = 4;
        float speed = 4;
        float angleT = 0;
        float arc1 = 15; //between shots
        float arc2 = -80; //between arcs
        int waitTime = 4;
        float wVel = 0.7;

        int loopFrames = stack * waitTime;

        loop (12) { //5 seconds
            if (!Boss_Alive(_objBoss)) return;
            for (int i = 0; i < stack; i++) {
                int color = [SHOT_PINK, SHOT_PINK_INV, SHOT_RED, SHOT_PINK_INV][i];
                for (int j = 0; j < way; j++) {
                    CreateShotUA2(MID_X, 90, speed, angleT, 0, speed, wVel, color+RING_L, 0, color+SPAWN_S+SIZE_16, color+CANCEL_32);
                    angleT += 360 / way;
                }
                angleT += arc1;
                CallSFX(SND_SHOT2);
                wait(waitTime);
            }
            wVel *= -1;
            angleT += arc2;
        }
        Animation_Charge(_objBoss, false);
        wait(30);
    }

    function<void> Phase2() {
        if (!Boss_Alive(_objBoss)) return;
        Animation_Charge(_objBoss, true);
        CallSFX(SND_CHARGE1);
        TChargeAnim();
        wait(30);
        if (!Boss_Alive(_objBoss)) return;

        int way = 8;
        int stack = 5;
        float speed = 4;
        float angleT = 0;
        float arc1 = -15; //between shots
        float arc2 = -80; //between arcs
        int waitTime = 3;
        float wVel = -0.7;

        int loopFrames = stack * waitTime;

        loop (18) { //5 seconds
            if (!Boss_Alive(_objBoss)) return;
            for (int i = 0; i < stack; i++) {
                int color = [SHOT_PINK, SHOT_PINK_INV, SHOT_RED, SHOT_PINK_INV, SHOT_PINK][i];
                for (int j = 0; j < way; j++) {
                    int shot = CreateShotUA2(MID_X, 90, speed, angleT, 0, speed, wVel, color+RING_S, 0, color+SPAWN_S+SIZE_16, color+CANCEL_BURST2);
                    angleT += 360 / way;
                }
                angleT += arc1;
                CallSFX(SND_SHOT2);
                wait(waitTime);
            }
            wVel *= -1;
            angleT += arc2;
        }
        Animation_Charge(_objBoss, false);
        wait(30);
        
    }

    function<void> Phase3() {
        if (!Boss_Alive(_objBoss)) return;
        Animation_Charge(_objBoss, true);
        CallSFX(SND_CHARGE1);
        TChargeAnim2();
        wait(30);
        if (!Boss_Alive(_objBoss)) return;

        //12 second nightmare

        int stack = 5;
        float speed = 4;
        float angleT = rand(0, 360);
        float waitTime = 10;
        int way = 0;

        loop {
            if (!Boss_Alive(_objBoss)) return;
            if (waitTime > 1) angleT = rand(0, 360);
            else angleT += 90/ way - 0.2;
            way = max(12 - waitTime, 6);
            for (int i = 0; i < way; i++) {
                CreateShotUA2(MID_X, 180, speed, angleT, 60 / speed, speed, 0, SHOT_RED+SWORD, 0, SHOT_RED+SPAWN_E+SIZE_16, SHOT_RED+CANCEL_BURST2);
                angleT += 360 / way;
            }
            CallSFX(SND_SHOT1);
            wait(waitTime);
            waitTime = max(1, waitTime - 0.2);
        }
    }
}

task TChargeAnim() {
    Primitive_ContractPolygon2D(_objBoss, 0, 368, 0, 45, 32, COLOR_WHITE, false, RP_STG_EFF_MID);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_WHITE);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_WHITE);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_PINK);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_PINK);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_PURPLE_L);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_PURPLE_L);
}

task TChargeAnim2() {
    Primitive_ContractPolygon2D(_objBoss, 0, 368, 0, 45, 32, COLOR_WHITE, false, RP_STG_EFF_MID);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 24, COLOR_PINK);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 24, COLOR_PINK);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 24, COLOR_RED_L);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 24, COLOR_RED_L);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 24, COLOR_RED_D);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 24, COLOR_RED_D);

    wait(200);
    if (!Boss_Alive(_objBoss)) return;
    CallSFX(SND_CHARGE2);
    Primitive_ContractPolygon2D(_objBoss, 0, 368, 0, 45, 32, COLOR_WHITE, false, RP_STG_EFF_MID);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 24, COLOR_PINK);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 24, COLOR_PINK);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 24, COLOR_RED_L);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 24, COLOR_RED_L);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 24, COLOR_RED_D);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 24, COLOR_RED_D);
}