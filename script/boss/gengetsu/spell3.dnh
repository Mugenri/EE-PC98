#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Spell 3"]
#System["./../../system/System.dnh"]

#include "./lib_Gengetsu.dnh"

int _objBoss;
int _count = -30;
int _loopTime = 220;
_spellID = 2;

@Event {
    alternative (GetEventType())
    case (EV_REQUEST_LIFE) {
        SetScriptResult(2200);
    }
    case (EV_REQUEST_TIMER) {
        SetScriptResult(40 + absolute(_count / 60));
    }
}

@Initialize {
    Boss_Init(false);
    _objBoss = Boss_Create(BOSS_ID_GENGETSU);
    TInitialize();
    TFinalize();
    TMain();
}

@MainLoop {
    Boss_Update(_objBoss);
    _count++;
    yield;
}

task TInitialize() {
    Gengetsu_Init(_objBoss);
    if (GetGameMode() == GAME_SPELL) Gengetsu_Move(_objBoss, MID_X, 90, 30);
    wait(30);
    Boss_SetVulnerable(_objBoss, true);
    TRage();
}

task TFinalize() {
    while (Boss_Alive(_objBoss)) yield;
    Gengetsu_Move(_objBoss, MID_X, 60, 60);
    Animation_Charge(_objBoss, false);
    Boss_Finalize(_objBoss);
}

task TMain() {
    while (_count < -30) yield;
    while (Boss_Alive(_objBoss)) {
        if (!_isInvuln) Boss_SetIntersection(_objBoss, _intersectionShot, 0);
        if (_count % _loopTime == 0 && _count >= 0) {
            async {
                TSpin();
            }
        }
        yield;
    }
}

task TSpin() {
    //scarlet meister
    //way symmetry, stack random bullets spread over -arc, arc from angle

    if (!Boss_Alive(_objBoss)) return;
    CallSFX(SND_CHARGE1);
    TChargeAnim();
    Animation_Charge(_objBoss, true);
    wait(60);
    if (!Boss_Alive(_objBoss)) return;

    int shots = 8;
    int wayMax = 18;
    int way = 1;
    int stack = 12;
    float speed = 4;
    float arcStart = 150;
    float arcEnd = 40;
    float arcMax = arcStart;
    int waitTime = 3;
    float x = Boss_X(_objBoss);
    float y = Boss_Y(_objBoss);


    for (int k = 0; k < shots; k++) {
        if (!Boss_Alive(_objBoss)) return;
        float angleBase = GetAngleToPlayer(_objBoss);
        float angle = angleBase;
        int color = SHOT_PINK;
        int type = BUBBLE;
        bool notBubble = false;
        int size = SIZE_32;
        int cancel = CANCEL_64;
        for (int i = 0; i < stack; i++) {
            for (int j = 0; j < way; j++) {
                int shot = CreateShotUA1(x, y, speed - Interpolate_Linear(0, 3.6, i / as_float(stack - 1)), angle, color+type, 0, (color+SPAWN_S+size)*notBubble, color+cancel);
                if (i == 0) Obj_SetRenderPriorityI(shot, RP_STG_SHOT - 1);
                angle += 360 / way;
            }
            float arcLen = Interpolate_Accelerate(arcMax / 5, arcMax, i / as_float(stack - 1));
            float arc = rand(-arcLen, arcLen);
            notBubble = true;
            if (absolute(arc) < arcMax / 4) {
                color = rand_int(0, 1) == 0 ? SHOT_RED : SHOT_PURPLE;
                type = HEART_L;
                size = SIZE_32;
                cancel = CANCEL_32;
            } else {
                color = SHOT_PINK;
                type = RING_S;
                size = SIZE_16;
                cancel = CANCEL_BURST2;
            }
            angle = angleBase + arc;
        }
        if (k == shots - 2) {
            way = wayMax;
            arcMax = arcEnd;
            CallSFX(SND_SHOT4);
        } else {
            CallSFX(SND_SHOT1);
        }
        wait(waitTime);
    }
    if (!Boss_Alive(_objBoss)) return;
    Animation_Charge(_objBoss, false);
    wait(40);
    if (!Boss_Alive(_objBoss)) return;
    Gengetsu_MoveRandom(_objBoss, 90, 16, 90, 60);
}

task TChargeAnim() {
    Primitive_ContractPolygon2D(_objBoss, 0, 368, 0, 45, 32, COLOR_WHITE, false, RP_STG_EFF_MID);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_WHITE);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_WHITE);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_PINK);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_PINK);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_PURPLE_L);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_PURPLE_L);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_RED);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_RED);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_RED_D);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_RED_D);
}