#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Spell 13"]
#System["./../../system/System.dnh"]

#include "./lib_Gengetsu.dnh"

int _objBoss;
int _count = -30;
int _loopTime = 500;
_spellID = 12;

@Event {
    alternative (GetEventType())
    case (EV_REQUEST_LIFE) {
        SetScriptResult(3500);
    }
    case (EV_REQUEST_TIMER) {
        SetScriptResult(40 + absolute(_count / 60));
    }
}

@Initialize {
    Boss_Init(false);
    _objBoss = Boss_Create(BOSS_ID_GENGETSU);
    TInitialize();
    TFinalize();
    TMain();
}

@MainLoop {
    Boss_Update(_objBoss);
    _count++;
    yield;
}

task TInitialize() {
    Gengetsu_Init(_objBoss);
    if (GetGameMode() == GAME_SPELL) Gengetsu_Move(_objBoss, MID_X, 90, 30);
    wait(30);
    Boss_SetVulnerable(_objBoss, true);
    TRage();
}

task TFinalize() {
    while (Boss_Alive(_objBoss)) yield;
    Gengetsu_Move(_objBoss, MID_X, 90, 60);
    Animation_Charge(_objBoss, false);
    Boss_Finalize(_objBoss);
}

task TMain() {
    while (_count < -30) yield;
    while (Boss_Alive(_objBoss)) {
        if (!_isInvuln) Boss_SetIntersection(_objBoss, _intersectionShot, 0);
        if (_count % _loopTime == 0 && _count >= 0) {
            async {
                TBurst();
            }
        }
        yield;
    }
}

task TBurst() {
    //dbdb
    if (!Boss_Alive(_objBoss)) return;
    TChargeAnim();
    Animation_Charge(_objBoss, true);
    CallSFX(SND_CHARGE1);
    wait(45);
    if (!Boss_Alive(_objBoss)) return;

    int way = 3;
    int stack = 4;
    int shots = 45;
    float minSpeed = 2;
    float maxSpeed = 4;
    int rad = 32;
    float angle = rand(0, 360);
    float minArc = 12;
    float maxArc = 30;
    int waitTime = 4;

    float x = Boss_X(_objBoss);
    float y = Boss_Y(_objBoss);
    for (int i = 0; i < shots; i++) {
        if (!Boss_Alive(_objBoss)) return;
        float rot = rand(0, 360);
        float speed = rand(minSpeed, maxSpeed);
        for (int k = 0; k < way; k++) {
            for (int j = 0; j < stack; j++) {
                float aMod = 360 / stack * j;
                CreateShotUA1(x + rad * cos(rot + aMod), y + rad * sin(rot + aMod), speed, angle, SHOT_PINK+RING_S, 0, SHOT_PINK+SPAWN_S+SIZE_16, SHOT_PINK+CANCEL_BURST2);
            }
            angle += 360 / way;
        }
        CallSFX(SND_SHOT1);
        angle += rand(minArc, maxArc);
        wait(waitTime);
    }
    Animation_Charge(_objBoss, false);
    wait(17);

    TFreeze();

    wait(10);
    if (!Boss_Alive(_objBoss)) return;
    Gengetsu_MoveRandom(_objBoss, 96, 16, 60);
}

task TFreeze() {
    //get bullet IDs
    if (!Boss_Alive(_objBoss)) return;
    CallSFX(SND_LASER2);

    float accel = 0.009;
    float speed = 3.5;
    float wvel = 1;
    float arc = 0.2;
    int laserDelay = 60;
    int laserTime = 90;

    int[] shots = GetShotIdInCircleA2(MID_X, MID_Y, 400, TARGET_ENEMY);
    for each (shot in shots) {
        ObjMove_SetSpeed(shot, 0);
        ObjShot_SetGraphic(shot, SHOT_GRAY+RING_S);
        Obj_SetValueI(shot, SHOT_EFFECT, SHOT_GRAY+CANCEL_BURST2);
    }
    wait(30);
    if (!Boss_Alive(_objBoss)) return;
    for each (shot in shots) {
        int dir = rand_int(0, 1) == 0 ? -1 : 1;
        int color = dir == 1 ? SHOT_BLUE : SHOT_YELLOW;
        int child = CreateShotUA2(ObjMove_GetX(shot), ObjMove_GetY(shot), 0, ObjMove_GetAngle(shot), accel, speed, wvel * dir, color+HEART_S, 0, color+SPAWN_E+SIZE_8, color+CANCEL_BURST2);
        ObjShot_SetAutoDelete(child, false);
        ObjMove_AddPatternA2(child, 180, NO_CHANGE, NO_CHANGE, accel, speed, 0);
        ObjShot_SetDeleteFrame(shot, 0);
        ObjShot_SetDeleteFrame(child, 450);
    }
    CallSFX(SND_SHOT2);

    wait(50);
    if (!Boss_Alive(_objBoss)) return;
    CallSFX(SND_CHARGE1);
    Animation_Charge(_objBoss, true);

    int laser = CreateStraightLaserUA1(Boss_X(_objBoss), Boss_Y(_objBoss), GetAngleToPlayer(_objBoss), 400, laserTime, COLOR_PINK, laserDelay);
    ObjShot_SetGrazeInvalidFrame(laser, 5);
    wait(laserDelay);
    if (!Boss_Alive(_objBoss)) return;
    CallSFX(SND_LASER1);
    loop (laserTime / 5) {
        if (!Boss_Alive(_objBoss)) return;
        float a1 = GetAngleToPlayer(_objBoss);
        float a2 = ObjStLaser_GetAngle(laser);
        float dir = a1 < a2 ? -1 : 1;
        float realArc = arc * dir * 5;
        if (absolute(a1 - a2) < realArc) a2 = a1;
        else a2 += realArc;
        ObjStLaser_SetAngle(laser, a2);
        wait(5);
    }
    Animation_Charge(_objBoss, false);
    
}

task TChargeAnim() {
    Primitive_ContractPolygon2D(_objBoss, 0, 368, 0, 45, 32, COLOR_WHITE, false, RP_STG_EFF_MID);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_WHITE);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_WHITE);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_GRAY_L);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_GRAY_L);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_GRAY);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_GRAY);
}