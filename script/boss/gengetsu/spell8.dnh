#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Spell 8"]
#System["./../../system/System.dnh"]

#include "./lib_Gengetsu.dnh"

int _objBoss;
int _count = -30;
int _loopTime = 300;
_spellID = 7;

@Event {
    alternative (GetEventType())
    case (EV_REQUEST_LIFE) {
        SetScriptResult(3000);
    }
    case (EV_REQUEST_TIMER) {
        SetScriptResult(35 + absolute(_count / 60));
    }
}

@Initialize {
    Boss_Init(false);
    _objBoss = Boss_Create(BOSS_ID_GENGETSU);
    TInitialize();
    TFinalize();
    TMain();
}

@MainLoop {
    Boss_Update(_objBoss);
    _count++;
    yield;
}

task TInitialize() {
    Gengetsu_Init(_objBoss);
    if (GetGameMode() == GAME_SPELL) Gengetsu_Move(_objBoss, MID_X, 120, 30);
    wait(30);
    Boss_SetVulnerable(_objBoss, true);
    TRage();
}

task TFinalize() {
    while (Boss_Alive(_objBoss)) yield;
    Gengetsu_Move(_objBoss, MID_X, 60, 60);
    Animation_Charge(_objBoss, false);
    Boss_Finalize(_objBoss);
}

task TMain() {
    while (_count < -30) yield;
    while (Boss_Alive(_objBoss)) {
        if (!_isInvuln) Boss_SetIntersection(_objBoss, _intersectionShot, 0);
        if (_count % _loopTime == 0 && _count >= 0) {
            async {
                TRing();
            }
        }
        yield;
    }
}

task TRing() {
    if (!Boss_Alive(_objBoss)) return;
    Animation_Charge(_objBoss, true);
    CallSFX(SND_CHARGE1);
    TChargeAnim();
    wait(45);
    if (!Boss_Alive(_objBoss)) return;

    int way = 12;
    float angleT = rand(260 - 360 / way, 260);
    int waitTime = 8;
    float accel = 0.06;
    float speed = 5.5;
    int margin = 10;
    int waitTime2 = 45;
    int frames = 75;

    int ringWay = 16;
    float ringSpeed = 1.7;
    float ringAccel = 0.01;
    float ringRad = 12;

    for (int i = 0; i < way; i++) {
        if (!Boss_Alive(_objBoss)) return;
        TAnchor(angleT);
        angleT -= 360 / way;
        wait(waitTime);
    }

    float randX = rand(-32, 32);
    float randY = rand(-16, 16);
    Animation_Charge(_objBoss, false);
    Gengetsu_Move(_objBoss, MID_X + randX, 120 + randY, 60);

    task TAnchor(float angle_) {
        float xPos = Boss_X(_objBoss);
        float yPos = Boss_Y(_objBoss);
        int shot = CreateShotUA2(xPos, yPos, 0.5, angle_, accel, speed, 0, SHOT_PINK+HEART_L, 0, SHOT_PINK+SPAWN_E+SIZE_32, SHOT_PINK+CANCEL_32);
        ObjShot_SetSpellResist(shot, true);
        CallSFX(SND_SHOT3);

        async {
            //spawn knockout
            wait(10);
            float rad = 8;
            //red
            for (int i = 0; i < 18; i++) {
                if (!Boss_Alive(_objBoss)) return;
                float x = ObjMove_GetX(shot);
                float y = ObjMove_GetY(shot);
                float temp = rand(0, 360);
                int child = CreateShotUA1(x + rad * cos(temp), y + rad * sin(temp), 0, ObjMove_GetAngle(shot) + rand((22 - i) * -2, (22 - i) * 2), SHOT_RED+CRYSTAL_S, 0, SHOT_RED+SPAWN_S+SIZE_16, SHOT_RED+CANCEL_SPARKLE);
                ObjMove_AddPatternA2(child, 60 - i * 2, NO_CHANGE, NO_CHANGE, 0.01, 1.5, 0);
                CallSFX(SND_SHOT2);
                wait(2);
            }

            //blue
            rad = 24;
            for (int i = 0; i < 10; i++) {
                if (!Boss_Alive(_objBoss)) return;
                float x = ObjMove_GetX(shot);
                float y = ObjMove_GetY(shot);
                loop (2) {
                    float temp = rand(0, 360);
                    int child = CreateShotUA1(x + rad * cos(temp), y + rad * sin(temp), 0, ObjMove_GetAngle(shot) + rand(-i * 4, i * 4), SHOT_WHITE+CRYSTAL_S, 0, SHOT_WHITE+SPAWN_S+SIZE_16, SHOT_WHITE+CANCEL_SPARKLE);
                    ObjMove_AddPatternA2(child, 100 - i * 2, NO_CHANGE, NO_CHANGE, 0.01, 1.5, 0);
                }
                CallSFX(SND_SHOT2);
                wait(2);
            }
        }

        while (Shot_IsInBounds(shot, margin)) yield;
        if (!Boss_Alive(_objBoss)) return;
        ObjMove_SetSpeed(shot, 0);
        ObjMove_SetAcceleration(shot, 0);
        CallSFX(SND_SHOT1);

        //spawn rings
        float angleT = rand(0, 360);
        for (int i = 0; i < ringWay; i++) {
            CreateShotUA2(ObjMove_GetX(shot) + ringRad * cos(angleT), ObjMove_GetY(shot) + ringRad * sin(angleT), 0, angleT, ringAccel, ringSpeed, 0, SHOT_BLUE+NEEDLES, 0, SHOT_BLUE+SPAWN_S+SIZE_16, SHOT_BLUE+CANCEL_SPARKLE);
            angleT += 360 / ringWay;
        }

        wait(waitTime2);
        if (!Boss_Alive(_objBoss)) return;

        float initX = ObjMove_GetX(shot);
        float initY = ObjMove_GetY(shot);
        int temp = Interpolate_Linear(frames, 45, distance(initX, initY, Boss_X(_objBoss), Boss_Y(_objBoss)) / 400.0);
        for (int i = 0; i < temp; i++) {
            if (!Boss_Alive(_objBoss)) return;
            float bossX = Boss_X(_objBoss);
            float bossY = Boss_Y(_objBoss);
            ObjMove_SetX(shot, Interpolate_Accelerate(initX, bossX, i / as_float(temp + 1)));
            ObjMove_SetY(shot, Interpolate_Accelerate(initY, bossY, i / as_float(temp + 1)));
            ObjMove_SetAngle(shot, dottheta(ObjMove_GetX(shot), ObjMove_GetY(shot), bossX, bossY) + 180);
            yield;
        }
        if (!Obj_IsDeleted(shot)) ObjShot_SetDeleteFrame(shot, 0);
    }
}

task TChargeAnim() {
    Primitive_ContractPolygon2D(_objBoss, 0, 368, 0, 45, 32, COLOR_WHITE, false, RP_STG_EFF_MID);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_WHITE);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_WHITE);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_PINK);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_PINK);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_PURPLE_L);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_PURPLE_L);
}