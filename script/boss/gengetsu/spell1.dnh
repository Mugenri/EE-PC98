#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Spell 1"]
#System["./../../system/System.dnh"]

#include "./lib_Gengetsu.dnh"

int _objBoss;
int _count = -30;
int _loopTime = 450;
_spellID = 0;

@Event {
    alternative (GetEventType())
    case (EV_REQUEST_LIFE) {
        SetScriptResult(3000);
    }
    case (EV_REQUEST_TIMER) {
        SetScriptResult(40 + absolute(_count / 60));
    }
}

@Initialize {
    Boss_Init(false);
    _objBoss = Boss_Create(BOSS_ID_GENGETSU);
    TInitialize();
    TFinalize();
    TMain();
}

@MainLoop {
    Boss_Update(_objBoss);
    _count++;
    yield;
}

task TInitialize() {
    Gengetsu_Init(_objBoss);
    if (GetGameMode() == GAME_MAIN) { //time for transition
        ObjMove_SetPosition(_objBoss, MID_X, 60);
        _count -= 90;
        wait(30);
        Transition_Spell(5, 1, 0, COLOR_WHITE);
        CallSFX(SND_TRANSITION);
        wait(60);
    } else {
        Gengetsu_Move(_objBoss, MID_X, 60, 30);
    }
    wait(30);
    Boss_SetVulnerable(_objBoss, true);
}

task TFinalize() {
    while (Boss_Alive(_objBoss)) yield;
    Gengetsu_Move(_objBoss, MID_X, 60, 60); //TODO for final spell check if not game main
    Animation_Charge(_objBoss, false);
    Boss_Finalize(_objBoss);
}

task TMain() {
    while (_count < -30) yield;
    while (Boss_Alive(_objBoss)) {
        if (!_isInvuln) Boss_SetIntersection(_objBoss, _intersectionShot, 0);
        if (_count % _loopTime == 0 && _count >= 0) {
            async {
                TRings();
                wait(180);
                TSpray();
            }
        }
        yield;
    }
}

task TRings() {
    if (!Boss_Alive(_objBoss)) return;
    Animation_Charge(_objBoss, true);
    CallSFX(SND_CHARGE1);
    TChargeAnim();
    wait(45);
    if (!Boss_Alive(_objBoss)) return;
    //trembling shivering star
    int way = 80;
    int stack = 5;
    int waitTime = 8;
    float speed = 4;

    float angleT = rand(0, 360);
    for (int i = 0; i < stack; i++) {
        if (!Boss_Alive(_objBoss)) return;
        for (int j = 0; j < way; j++) {
            CreateShotUA1(Boss_X(_objBoss), Boss_Y(_objBoss), speed, angleT, SHOT_PINK+RING_S, 0, SHOT_PINK+SPAWN_S+SIZE_16, SHOT_PINK+CANCEL_BURST2);
            angleT += 360 / way;
        }
        CallSFX(SND_SHOT2);
        angleT += 180 / way;
        wait(waitTime);
    }

    Animation_Charge(_objBoss, false);
    wait(20);
    if (!Boss_Alive(_objBoss)) return;
    Gengetsu_MoveRandom(_objBoss, 90, 16, 60);
}

task TSpray() {
    if (!Boss_Alive(_objBoss)) return;
    Animation_Charge(_objBoss, true);
    CallSFX(SND_CHARGE1);
    TChargeAnim();
    wait(45);
    if (!Boss_Alive(_objBoss)) return;

    int way = 7;
    int stack = 40;
    float minInc = 2;
    float maxInc = 12;
    float arc = 10;
    float speedMin = 0.65;
    float speedMax = 3.8; 
    float angleT = rand(-40, -20);
    int waitTime = 2;

    for (int i = 0; i < stack; i++) {
        if (!Boss_Alive(_objBoss)) return;
        float speed = rand(speedMin, speedMax);
        float angle = angleT;
        for (int j = 0; j < way; j++) {
            int shot = j == 3 ? RING_S : PELLET;
            CreateShotUA1(Boss_X(_objBoss), Boss_Y(_objBoss), speed, angle, SHOT_PINK+shot, 0, SHOT_PINK+SPAWN_S+SIZE_8, SHOT_PINK+CANCEL_BURST1);
            CreateShotUA1(Boss_X(_objBoss), Boss_Y(_objBoss), speed, -angle + 180, SHOT_PINK+shot, 0, SHOT_PINK+SPAWN_S+SIZE_8, SHOT_PINK+CANCEL_BURST1);
            angle += arc;
        }
        CallSFX(SND_SHOT2);
        angleT += rand(minInc, maxInc);
        wait(waitTime);
    }

    Animation_Charge(_objBoss, false);
    wait(20);
    if (!Boss_Alive(_objBoss)) return;
    Gengetsu_MoveRandom(_objBoss, 90, 16, 60);
}

task TChargeAnim() {
    Primitive_ContractPolygon2D(_objBoss, 0, 368, 0, 45, 32, COLOR_WHITE, false, RP_STG_EFF_MID);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_WHITE);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_WHITE);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_PINK);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_PINK);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_PURPLE_L);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_PURPLE_L);
}