#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Spell 14"]
#System["./../../system/System.dnh"]

#include "./lib_Gengetsu.dnh"

int _objBoss;
int _count = -30;
int _loopTime = 800;
_spellID = 13;

@Event {
    alternative (GetEventType())
    case (EV_REQUEST_LIFE) {
        SetScriptResult(3800);
    }
    case (EV_REQUEST_TIMER) {
        SetScriptResult(50 + absolute(_count / 60));
    }
}

@Initialize {
    Boss_Init(false);
    _objBoss = Boss_Create(BOSS_ID_GENGETSU);
    TInitialize();
    TFinalize();
    TMain();
}

@MainLoop {
    Boss_Update(_objBoss);
    _count++;
    yield;
}

task TInitialize() {
    Gengetsu_Init(_objBoss);
    if (GetGameMode() == GAME_SPELL) Gengetsu_Move(_objBoss, MID_X, 90, 30);
    wait(290);
    Boss_SetVulnerable(_objBoss, true);
    TRage();
}

task TFinalize() {
    while (Boss_Alive(_objBoss)) yield;
    Gengetsu_Move(_objBoss, MID_X, 60, 60);
    Animation_Charge(_objBoss, false);
    Boss_Finalize(_objBoss);
}

task TMain() {
    while (_count < -30) yield;
    int dir = 1;
    while (Boss_Alive(_objBoss)) {
        if (!_isInvuln) Boss_SetIntersection(_objBoss, _intersectionShot, 0);
        if (_count % _loopTime == 0 && _count >= 0) {
            async {
                Phase1(dir);
                dir *= -1;
                Phase2();
            }
        }
        yield;
    }
}

function<void> Phase1(int dir_) {
    //sparks from hands? yes
    //wait
    //spawn shots and rotate 90 degrees
    //move

    int moveTime = 90;
    float arc = 90;
    int way = 14;
    float dist = 400;
    int waitTime = 4;
    float speed = 1.8;
    float accel = 0.004;

    if (!Boss_Alive(_objBoss)) return;
    Animation_Charge(_objBoss, true);
    CallSFX(SND_CHARGE1);
    TChargeAnim();
    yield; //annoying
    if (!Boss_Alive(_objBoss)) return;
    float x = Boss_X(_objBoss);
    float y = Boss_Y(_objBoss);
    int laser1 = CreateMasterSpark(x + 16, y - 3, 0, MAX_Y, 32, moveTime, COLOR_BLUE, COLOR_INDIGO_L, 45);
    int laser2 = CreateMasterSpark(x - 16, y - 3, 180, MAX_Y, 32, moveTime, COLOR_BLUE, COLOR_INDIGO_L, 45);
    wait(45); //delay time
    CallSFX(SND_MASTERSPARK);
    wait(40); //laser expand time
    if (!Boss_Alive(_objBoss)) return;


    for (int i = 1; i <= moveTime; i++) {
        if (!Boss_Alive(_objBoss)) return;
        float angle = Interpolate_Smoother(0, arc, i / as_float(moveTime)) * dir_;
        ObjStLaser_SetAngle(laser1, 0 + angle);
        ObjStLaser_SetAngle(laser2, 180 + angle);
        if (i % waitTime == 0) {
            SpawnLine(laser1, i);
            SpawnLine(laser2, i);
            CallSFX(SND_SHOT1);
        }
        yield;
    }

    Animation_Charge(_objBoss, false);
    wait(75);
    if (!Boss_Alive(_objBoss)) return;
    Gengetsu_Move(_objBoss, GetPlayerX(), 60 + rand(-16, 16), 60);
    wait(75);

    function<void> SpawnLine(int obj_, int delay_) {
        float x = ObjMove_GetX(obj_);
        float y = ObjMove_GetY(obj_);
        float angleL = ObjStLaser_GetAngle(obj_);
        float angleT = angleL + 90 * dir_;

        for (int i = 0; i < way; i++) {
            float radius = Interpolate_Linear(0, dist, i / as_float(way - 1));
            float xPos = x + radius * cos(angleL);
            float yPos = y + radius * sin(angleL);
            CreateShotUA2(xPos, yPos, 0, angleT, accel + 0.0005 * delay_, speed, 0, SHOT_RED+PILL_S, 0, SHOT_RED+SPAWN_S+SIZE_16, SHOT_RED+CANCEL_BURST1);
            CreateShotUA2(xPos, yPos, 0, angleT + 180, accel + 0.0005 * delay_, speed, 0, SHOT_RED+PILL_S, 0, SHOT_RED+SPAWN_S+SIZE_16, SHOT_RED+CANCEL_BURST1);
        }
    }
}

function<void> Phase2() {
    if (!Boss_Alive(_objBoss)) return;
    yield;
    float x = Boss_X(_objBoss);
    float y = Boss_Y(_objBoss);
    TLanes();
    wait(40);
    if (!Boss_Alive(_objBoss)) return;
    Animation_Charge(_objBoss, true);
    CallSFX(SND_CHARGE1);
    TChargeAnim();
    wait(30);
    int laser1 = CreateMasterSpark(x, y - 5, 90, MAX_Y, 96, 150, COLOR_BLUE, COLOR_INDIGO_L, 60);
    wait(60);
    CallSFX(SND_MASTERSPARK);



    task TLanes() {
        if (!Boss_Alive(_objBoss)) return;
        TBullets(1);
        TBullets(-1);
        wait(40);
        TLines(true);
        wait(96);

        if (!Boss_Alive(_objBoss)) return;
        TBullets(1);
        TBullets(-1);
        wait(40);
        TLines(false);
        wait(96);

        if (!Boss_Alive(_objBoss)) return;
        TBullets(1);
        TBullets(-1);
        wait(40);
        TLines(false);
        TLines(true);
        wait(96);

        if (!Boss_Alive(_objBoss)) return;
        Animation_Charge(_objBoss, false);
        Gengetsu_MoveRandom(_objBoss, 64, 16, 60);

        //two lanes from hands
        task TBullets(int dir_) {
            if (!Boss_Alive(_objBoss)) return;
            int stack = 40;
            float angleT = dir_ > 0 ? 0 : 180;
            for (int i = 0; i < stack; i++) {
                if (!Boss_Alive(_objBoss)) return;
                CreateShotUA1(x + 16 * dir_, y, 9, angleT - 45, SHOT_WHITE+RING_S, 0, SHOT_WHITE+SPAWN_E+SIZE_16, SHOT_WHITE+CANCEL_BURST2);
                CreateShotUA1(x + 16 * dir_, y, 9, angleT - 15, SHOT_WHITE+RING_S, 0, SHOT_WHITE+SPAWN_E+SIZE_16, SHOT_WHITE+CANCEL_BURST2);
                CreateShotUA1(x + 16 * dir_, y, 9, angleT, SHOT_WHITE+RING_S, 0, SHOT_WHITE+SPAWN_E+SIZE_16, SHOT_WHITE+CANCEL_BURST2);
                CreateShotUA1(x + 16 * dir_, y, 9, angleT + 15, SHOT_WHITE+RING_S, 0, SHOT_WHITE+SPAWN_E+SIZE_16, SHOT_WHITE+CANCEL_BURST2);
                CreateShotUA1(x + 16 * dir_, y, 9, angleT + 45, SHOT_WHITE+RING_S, 0, SHOT_WHITE+SPAWN_E+SIZE_16, SHOT_WHITE+CANCEL_BURST2);
                CallSFX(SND_SHOT1);
                yield;
            }
        }

        //bullet lines
        task TLines(bool vertical_) {
            if (!Boss_Alive(_objBoss)) return;
            int way = 16;
            int stack = 16;
            int waitTime = 4;
            int r = rand(-8, 8);
            int mx = vertical_ ? MAX_X : 0;
            int my = vertical_ ? 0 : MAX_Y;
            int rx = vertical_ ? r : 0;
            int ry = vertical_ ? 0 : r;
            float angle = vertical_ ? 90 : 0;

            //warning lasers
            for (int j = 0; j < way; j++) {
                int xPos = Interpolate_Linear(0, mx, j / as_float(way - 1)) + rx;
                int yPos = Interpolate_Linear(0, my, j / as_float(way - 1)) + ry;
                xPos += xPos % 8;
                yPos += yPos % 8;
                Laser_WarningLine(xPos, yPos, angle, 400, 60);
            }
            //aimed wave
            async {
                wait(40);
                if (!Boss_Alive(_objBoss)) return;
                float theta = GetAngleToPlayer(_objBoss);
                theta -= 240 / 7;
                for (int i = 0; i < 7; i++) {
                    if (!Boss_Alive(_objBoss)) return;
                    for (int j = 0; j < 12; j++) {
                        CreateShotUA1(x, y, Interpolate_Linear(0.8, 4.5, j / 11.0), theta, SHOT_PINK+RING_S, 0, SHOT_PINK+SPAWN_S+SIZE_16, SHOT_PINK+CANCEL_BURST2);
                    }
                    theta += 80 / 7;
                    CallSFX(SND_SHOT2);
                    wait(7);
                }
            }
            wait(40);
            //bullets
            for (int i = 0; i < stack; i++) {
                if (!Boss_Alive(_objBoss)) return;
                for (int j = 0; j < way; j++) {
                    int xPos = Interpolate_Linear(0, mx, j / as_float(way - 1)) + rx;
                    int yPos = Interpolate_Linear(0, my, j / as_float(way - 1)) + ry;
                    xPos += xPos % 8;
                    yPos += yPos % 8;
                    CreateShotUA1(xPos, yPos, 7, angle, SHOT_WHITE+RING_S, 0, SHOT_WHITE+CANCEL_BURST2);
                }
                CallSFX(SND_SHOT1);
                wait(waitTime);
            }

        }
    }

}

task TChargeAnim() {
    Primitive_ContractPolygon2D(_objBoss, 0, 368, 0, 45, 32, COLOR_WHITE, false, RP_STG_EFF_MID);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_WHITE);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_WHITE);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_INDIGO_L);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_INDIGO_L);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_BLUE);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_BLUE);
}