//Tsurubami backgrounds
#include "./../../lib/lib_Common.dnh"
#include "./../../lib/lib_Background.dnh"
#include "./../../lib/effectlib/lib_EffectPrimitive.dnh"

bool _split;
int _color = 0x110011;

@Initialize {
    SetAutoDeleteObject(true);
    _split = false;
    BG_Init(GetScriptArgument(0));
}

@Event {
    BG_Event();
    alternative (GetEventType())
    case (EV_STAGE_START) { _split = true; }
}

@MainLoop { yield; }

function<void> ChangeIndex(int index_, int priority_) {
    //change to index (starts shutdown for current bg)
    _bIndex = index_;
    alternative (index_)
    case (0) { TBackgroundIntro(index_, priority_); }
    case (1) { TBackground(index_, priority_); }
    others { assert(false, IntToString(index_) ~ " is an invalid background index."); }
}

task TBackgroundIntro(int index_, int priority_) {
    bool exitFlag = false;
    //black bg
    int black = InitSprite2D(0, 0, MAX_X, MAX_Y, priority_);
    ObjRender_SetColor(black, COLOR_BLACK);
    //torii
    int bg = InitSprite2D(0, 0, MAX_X, MAX_Y, IMG_BG_GENGETSU, priority_ + 1);

    bool split = false;

    TParticles();

    while (!exitFlag) {
        if (index_ != _bIndex) {
            async { exitFlag = BG_Exit(); }
            index_ = _bIndex;
        }
        if (_split) {
            WriteLog("splittin");
            TSplit();
            _split = false;
        }
        yield;
    }

    task TParticles() {
        int bgParticle = InitParticleList(IMG_EFFECT_PARTICLE, priority_, [0, 0, 16, 16]);
        ParticleListShader(bgParticle, 16 / 512, 16 / 512);
        int frames = 4;
        int frameRate = 40;
        while (!split) {
            async {
                int frame = 0;
                float x = rand(MIN_X, MAX_X);
                float y = 235;
                float xSpeed = rand(-0.2, 0.2);
                float ySpeed = rand(-0.8, -1);
                while (frame < frames * frameRate) {
                    if (split) return;
                    ObjParticleList_SetPosition(bgParticle, x, y, 1);
                    ObjParticleList_SetExtraData(bgParticle, (frames - 1) - frame / frameRate, 0, 0);
                    ObjParticleList_SetColor(bgParticle, Interpolate_X_PackedInt(COLOR_GRAY_D, COLOR_BLACK, frame / frameRate / as_float(frames), LERP_LINEAR));
                    ObjParticleList_AddInstance(bgParticle);
                    frame++;
                    x += xSpeed;
                    y += ySpeed;
                    yield;
                }
            }
            yield;
        }
    }

    task TSplit() {
        wait(28);
        split = true;
        RenderToTextureA1(RT_ENDSCREEN, RP_STG_BG1, RP_STG_EFF_BG1, true);
        int freeze1 = InitSprite2D(0, 0, WINDOW_WIDTH, WINDOW_HEIGHT, RT_ENDSCREEN, _priority + 1);
        ObjSprite2D_SetSourceRect(freeze1, 32, 16, MID_X + 32, 384);
        ObjSprite2D_SetDestRect(freeze1, 0, 0, MID_X, MAX_Y);
        int freeze2 = InitSprite2D(0, 0, WINDOW_WIDTH, WINDOW_HEIGHT, RT_ENDSCREEN, _priority + 1);
        ObjSprite2D_SetSourceRect(freeze2, MID_X + 32, 16, MAX_X + 32, 384);
        ObjSprite2D_SetDestRect(freeze2, MID_X, 0, MAX_X, MAX_Y);
        Obj_SetVisible(bg, false);

        CallSFX(SND_EXPLOSION2);
        StartSlow(TARGET_ALL, 30);
        Primitive_ScreenFlashFinal(); //boss explosion screen flash
        wait(30);
        StopSlow(TARGET_ALL);
        int frames = 300;
        for (int i = 0; i < frames; i++) {
            float x = i / as_float(frames);
            ObjRender_SetPosition(freeze1, Interpolate_Linear(0, -3, x), Interpolate_Accelerate(0, 484, x), 1);
            ObjRender_SetPosition(freeze2, Interpolate_Linear(0, 2, x), Interpolate_Accelerate(0, 512, x), 1);
            yield;
        }
        Obj_Delete(freeze1);
        Obj_Delete(freeze2);
    }
}

task TBackground(int index_, int priority_) {
    bool exitFlag = false;
    //black bg
    int black = InitSprite2D(0, 0, MAX_X, MAX_Y, priority_);
    ObjRender_SetColor(black, COLOR_BLACK);
    //bg
    int bg = InitSprite2D(MAX_X, 0, MAX_X * 2, MAX_Y, IMG_BG_GENGETSU, priority_ + 1);

    TMoon();

    while (!exitFlag) {
        if (index_ != _bIndex) {
            async { exitFlag = BG_Exit(); }
            index_ = _bIndex;
        }
        yield;
    }

    task TMoon() {
        //moon prim
        int vertices = 130;
        int prim = InitPrim2D(PRIMITIVE_TRIANGLESTRIP, vertices, IMG_BG_GENGETSU_EFF, _priority);
        ObjRender_SetColor(prim, _color);
        
        //192, 80
        int xOrg = 192;
        int yOrg = 80;

        int radius = 350;
        float angleT = 14;
        for (int i = 0; i < vertices; i++) {
            if (i % 2 == 0) {
                ObjPrim_SetVertexPosition(prim, i, xOrg + 64 * cos(angleT), yOrg + 64 * sin(angleT), 1);
            } else {
                ObjPrim_SetVertexPosition(prim, i, MID_X + radius * cos(angleT), MID_Y + radius * sin(angleT), 1);
                angleT += 360 / ((vertices / 2) - 1);
            }
        }

        float anim = 0;
        while (!exitFlag) {
            UpdatePrim(anim);
            anim -= 0.1 % 16;
            yield;
        }

        Obj_Delete(prim);

        function<void> UpdatePrim(float mod_) {
            ObjRender_SetColor(prim, _color);
            for (int i = 0; i < vertices; i++) {
                if (i % 2 == 0) {
                    ObjPrim_SetVertexUVT(prim, i, 4 * i, 0 + mod_);
                } else {
                    ObjPrim_SetVertexUVT(prim, i, 4 * i - 4 , 196 + mod_);
                }
            }
        }

    }

    Obj_Delete(black);
    Obj_Delete(bg);
}