#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Spell 5"]
#System["./../../system/System.dnh"]

#include "./lib_Gengetsu.dnh"

int _objBoss;
int _count = -30;
int _loopTime = 240;
_spellID = 4;

@Event {
    alternative (GetEventType())
    case (EV_REQUEST_LIFE) {
        SetScriptResult(4000);
    }
    case (EV_REQUEST_TIMER) {
        SetScriptResult(45 + absolute(_count / 60));
    }
}

@Initialize {
    Boss_Init(false);
    _objBoss = Boss_Create(BOSS_ID_GENGETSU);
    TInitialize();
    TFinalize();
    TMain();
}

@MainLoop {
    Boss_Update(_objBoss);
    _count++;
    yield;
}

task TInitialize() {
    Gengetsu_Init(_objBoss);
    if (GetGameMode() == GAME_SPELL) Gengetsu_Move(_objBoss, MID_X, 120, 30);
    wait(90);
    Boss_SetVulnerable(_objBoss, true);
    TRage();
}

task TFinalize() {
    while (Boss_Alive(_objBoss)) yield;
    Gengetsu_Move(_objBoss, MID_X, MID_Y - 48, 60);
    Animation_Charge(_objBoss, false);
    Boss_Finalize(_objBoss);
}

task TMain() {
    while (_count < -30) yield;
    while (Boss_Alive(_objBoss)) {
        if (!_isInvuln) Boss_SetIntersection(_objBoss, _intersectionShot, 0);
        if (_count % _loopTime == 0 && _count >= 0) {
            async {
                TStar();
            }
        }
        yield;
    }
}

task TStar() {
    //apollo 13 / gray thaumaturgy
    //star with bullets rotating angle
    if (!Boss_Alive(_objBoss)) return;
    Animation_Charge(_objBoss, true);
    CallSFX(SND_CHARGE1);
    TChargeAnim();
    wait(45);
    if (!Boss_Alive(_objBoss)) return;

    int way = 20;
    int stack = 13;
    float rad = 112;
    float angle = 90;
    float a1 = 0;
    float a2 = 0;
    float aMod = rand(190, 460);
    float arc = rand(8, 10);
    float speed = 1.5;
    float accel = 0.01;
    int pauseTime = 120;
    int delayMod = 0;
    for (int i = 0; i < way; i++) {
        float x = Boss_X(_objBoss);
        float y = Boss_Y(_objBoss);
        a2 = a1 + 360 / 5 * 3;
        float x1 = x + rad * cos(angle + a1);
        float y1 = y + rad * sin(angle + a1);
        float x2 = x + rad * cos(angle + a2); 
        float y2 = y + rad * sin(angle + a2); 
        float x3 = x + rad / 1.5 * cos(-angle + a1);
        float y3 = y + rad / 1.5 * sin(-angle + a1);
        float x4 = x + rad / 1.5 * cos(-angle + a2); 
        float y4 = y + rad / 1.5 * sin(-angle + a2); 

        for (int j = 0; j < stack; j++) {
            int shot1 = CreateShotUA2(Interpolate_Accelerate(x1, x2, j / as_float(stack)), Interpolate_Accelerate(y1, y2, j / as_float(stack)), 0, aMod, 0, speed, 0, SHOT_BLUE_INV+BALL_S, 0, SHOT_BLUE_INV+SPAWN_S+SIZE_16, SHOT_BLUE+CANCEL_FADE);
            int shot2 = CreateShotUA2(Interpolate_Decelerate(x3, x4, j / as_float(stack)), Interpolate_Decelerate(y3, y4, j / as_float(stack)), 0, aMod, 0, speed, 0, SHOT_BLUE_INV+PELLET, 0, SHOT_BLUE+SPAWN_S+SIZE_8, SHOT_BLUE_INV+CANCEL_BURST1);
            Obj_SetRenderPriorityI(shot1, RP_STG_SHOT - 1);
            ObjMove_AddPatternA3(shot1, pauseTime - delayMod, NO_CHANGE, aMod, accel, NO_CHANGE, NO_CHANGE, SHOT_BLUE+BALL_S);
            ObjMove_AddPatternA3(shot2, pauseTime - delayMod, NO_CHANGE, aMod, accel / 1.6, NO_CHANGE, NO_CHANGE, SHOT_BLUE+PELLET);
            aMod -= arc;
            CallSFX(SND_SHOT1);
            if (j % 4 == 0) {
                delayMod++;
                yield;
                if (!Boss_Alive(_objBoss)) return;
            }
        }
        a1 = a2;
        if (i % 5 == 4) angle += 360 / way;
    }
    Animation_Charge(_objBoss, false);
    wait(pauseTime - delayMod);
    if (!Boss_Alive(_objBoss)) return;
    CallSFX(SND_SHOT2);
}

task TChargeAnim() {
    Primitive_ContractPolygon2D(_objBoss, 0, 368, 0, 45, 32, COLOR_WHITE, false, RP_STG_EFF_MID);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_WHITE);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_WHITE);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_INDIGO_L);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_INDIGO_L);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_BLUE);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_BLUE);
}