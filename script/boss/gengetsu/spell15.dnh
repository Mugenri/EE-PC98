#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Spell 15"]
#System["./../../system/System.dnh"]

#include "./lib_Gengetsu.dnh"

int _objBoss;
int _count = -30;
int _loopTime = 360;
_spellID = 14;

@Event {
    alternative (GetEventType())
    case (EV_REQUEST_LIFE) {
        SetScriptResult(4000);
    }
    case (EV_REQUEST_TIMER) {
        SetScriptResult(40 + absolute(_count / 60));
    }
}

@Initialize {
    Boss_Init(false);
    _objBoss = Boss_Create(BOSS_ID_GENGETSU);
    TInitialize();
    TFinalize();
    TMain();
}

@MainLoop {
    Boss_Update(_objBoss);
    _count++;
    yield;
}

task TInitialize() {
    Gengetsu_Init(_objBoss);
    if (GetGameMode() == GAME_SPELL) Gengetsu_Move(_objBoss, MID_X, 90, 30);
    wait(30);
    Boss_SetVulnerable(_objBoss, true);
    TRage();
    TJewel();
}

task TFinalize() {
    while (Boss_Alive(_objBoss)) yield;
    Gengetsu_Move(_objBoss, MID_X, 60, 60);
    Animation_Charge(_objBoss, false);
    Boss_Finalize(_objBoss);
}

task TMain() {
    while (_count < -30) yield;
    while (Boss_Alive(_objBoss)) {
        if (!_isInvuln) Boss_SetIntersection(_objBoss, _intersectionShot, 0);
        if (_count % _loopTime == 0 && _count >= 0) {
            async {
                TLasers(1);
                wait(_loopTime / 2);
                TLasers(-1);
            }
        }
        yield;
    }
}

task TJewel() {
    //hourai jewel pattern
    //16 bullet ring
    //two alternating angle increments
    //red purple blue cyan green yellow orange

    while (_count < 0) yield;

    if (!Boss_Alive(_objBoss)) return;
    Animation_Charge(_objBoss, true);
    CallSFX(SND_CHARGE1);
    TChargeAnim();
    wait(45);
    if (!Boss_Alive(_objBoss)) return;

    float x = Boss_X(_objBoss);
    float y = Boss_Y(_objBoss);
    int way = 16;
    int[] colors = [SHOT_RED, SHOT_WHITE, SHOT_PINK];
    int[] types = [BALL_S, HEART_S, RING_S, HEART_S];
    int len = length(colors);
    int len2 = length(types);
    float radius = 12;
    float speed = 1.8;
    float a1 = 0;
    float a2 = 0;
    float aInc = 0;
    int waitTime = 14;

    int random = rand_int(0, 360);
    int i = 0;
    while (Boss_Alive(_objBoss)) {
        float x = Boss_X(_objBoss) + radius * cos(random + _count * 3);
        float y = Boss_Y(_objBoss) + radius * sin(random + _count * 4) - 8;
        float angle = i % 2 == 0 ? a2 : a1;
        int color = colors[i % len];
        int type = types[i % len2];
        for (int j = 0; j < way; j++) {
            CreateShotUA1(x + 38 * cos(angle), y + 38 * sin(angle), speed, angle + 180, color+type, 0, color+SPAWN_S+SIZE_16, color+CANCEL_FADE);
            angle += 360 / way;
        }
        CallSFX(SND_SHOT2);
        wait(waitTime);
        i++;
        if (i < 7) continue;
        a1 += aInc;
        a2 -= aInc;
        aInc = 0.8035;
        waitTime = 7;
    }
}

task TLasers(int dir_) {
    wait(45);
    if (!Boss_Alive(_objBoss)) return;
    //ring of lasers, spin, expand, fire, move off screen

    int way = 8;
    float angle = rand(0, 360);
    float maxInc = 8;
    float minInc = 0.3;
    float rad = 0;
    int delay = 140;
    int sustain = 220;
    int frames = delay + sustain;
    int[] colors = [COLOR_RED_L, COLOR_ORANGE, COLOR_YELLOW_L, COLOR_GREEN, COLOR_BLUE, COLOR_PURPLE, COLOR_PINK, COLOR_SKY];

    for (int i = 0; i < way; i++) {
        TLaser(angle, colors[i % way]);
        angle += 360 / way;
    }

    task TLaser(float angle_, int color_) {
        float x = Boss_X(_objBoss);
        float y = Boss_Y(_objBoss);
        float aInc = maxInc;
        int laser = CreateStraightLaserUA1(x, y, angle_, 450, sustain, color_, delay);
        ObjShot_SetSpellResist(laser, true);
        ObjShot_SetAutoDelete(laser, false);
        for (int i = 0; i < frames; i++) {
            if (!Boss_Alive(_objBoss)) return;
            ObjMove_SetPosition(laser, x + rad * cos(angle_), y + rad * sin(angle_));
            ObjStLaser_SetAngle(laser, angle_);
            angle_ += aInc * dir_;
            if (i <= delay - 20) aInc = Interpolate_Decelerate(maxInc, minInc, i / as_float(delay - 20));
            if (i == delay) CallSFX(SND_LASER1);
            rad = Interpolate_CubicBezier(0, 400, 2.3, 0.6, i / as_float(frames - 30));
            yield;
        }
    }
}

task TChargeAnim() {
    Primitive_ContractPolygon2D(_objBoss, 0, 368, 0, 45, 32, COLOR_WHITE, false, RP_STG_EFF_MID);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_WHITE);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_WHITE);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_PINK);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_PINK);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_RED_L);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_RED_L);
}