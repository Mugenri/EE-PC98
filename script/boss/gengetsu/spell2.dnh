#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Spell 2"]
#System["./../../system/System.dnh"]

#include "./lib_Gengetsu.dnh"

int _objBoss;
int _count = -30;
int _loopTime = 330;
_spellID = 1;

@Event {
    alternative (GetEventType())
    case (EV_REQUEST_LIFE) {
        SetScriptResult(3000);
    }
    case (EV_REQUEST_TIMER) {
        SetScriptResult(35 + absolute(_count / 60));
    }
}

@Initialize {
    Boss_Init(false);
    _objBoss = Boss_Create(BOSS_ID_GENGETSU);
    TInitialize();
    TFinalize();
    TMain();
}

@MainLoop {
    Boss_Update(_objBoss);
    _count++;
    yield;
}

task TInitialize() {
    Gengetsu_Init(_objBoss);
    if (GetGameMode() == GAME_SPELL) Gengetsu_Move(_objBoss, MID_X, 60, 30);
    wait(30);
    Boss_SetVulnerable(_objBoss, true);
    TRage();
}

task TFinalize() {
    while (Boss_Alive(_objBoss)) yield;
    Gengetsu_Move(_objBoss, MID_X, 60, 60);
    Animation_Charge(_objBoss, false);
    Boss_Finalize(_objBoss);
}

task TMain() {
    while (_count < -30) yield;
    while (Boss_Alive(_objBoss)) {
        if (!_isInvuln) Boss_SetIntersection(_objBoss, _intersectionShot, 0);
        if (_count % _loopTime == 0 && _count >= 0) {
            async {
                TRings();
                wait(120);
                TBounce();
            }
        }
        yield;
    }
}

task TRings() {
    //mishagujisama/demarcation
    if (!Boss_Alive(_objBoss)) return;
    Animation_Charge(_objBoss, true);
    CallSFX(SND_CHARGE1);
    TChargeAnim();
    wait(45);
    if (!Boss_Alive(_objBoss)) return;

    int way = 26;
    int stack = 5;
    float s1 = 3.6864;
    float s2 = 4.096;
    float arc = 5;
    int delayTime = 30;
    int waitTime = 10;
    float decelTime = 30;
    float speed1 = 1.3;
    float speed2 = 1.4;
    float angleT = rand(0, 360);
    int[] color = [SHOT_PINK, SHOT_WHITE, SHOT_PINK_INV, SHOT_WHITE, SHOT_RED_INV];

    for (int i = 0; i < stack; i++) {
        if (!Boss_Alive(_objBoss)) return;
        SpawnRing(s1, s2, angleT, delayTime, 1, color[i]);
        SpawnRing(s1, s2, angleT + arc, delayTime, -1, color[i]);
        s1 /= 0.8;
        s2 /= 0.8;
        angleT += 180 / way;
        delayTime += 14;
        CallSFX(SND_SHOT1);
        wait(waitTime);
    }

    function<void> SpawnRing(float speedMin_, speedMax_, float angleT_, int waitTime_, int dir_, int color_) {
        float x = Boss_X(_objBoss);
        float y = Boss_Y(_objBoss);
        for (int i = 0; i < way; i++) {
            int shot1 = CreateShotUA2(x, y, speedMin_, angleT_, -speedMin_ / decelTime, 0, 0, color_+CRYSTAL_S, 0, color_+SPAWN_E+SIZE_16, color_+CANCEL_SPARKLE); //inner
            int shot2 = CreateShotUA2(x, y, speedMax_, angleT_, -speedMax_ / decelTime, 0, 0, color_+CRYSTAL_S, 0, color_+SPAWN_E+SIZE_16, color_+CANCEL_SPARKLE); //outer
            ObjMove_AddPatternA1(shot1, decelTime + waitTime_, speed2, angleT_ + 90 * dir_);
            ObjMove_AddPatternA1(shot2, decelTime + waitTime_, speed1, angleT_ + 90 * dir_);
            angleT_ += 360 / way;
        }
    }
}

task TBounce() {
    //spawm from hands, bounce two times
    if (!Boss_Alive(_objBoss)) return;
    int[] shots = [];
    int way = 48;
    float speed = 5;
    float sMod = 2.5;
    float angleT = 45;
    float arc = 4;
    int waitTime = 1;

    async {
        while (Boss_Alive(_objBoss)) {
            for each (shot in shots) {
                if (!Obj_IsDeleted(shot)) {
                    if (!Shot_IsInBoundsX(shot)) {
                        float xPos = ObjMove_GetX(shot);
                        ObjMove_SetAngle(shot, ReflectAngle(ObjMove_GetAngle(shot), 90));
                        ObjMove_SetX(shot, xPos < 0 ? -xPos : MAX_X - (xPos - MAX_X));
                    } else if (ObjMove_GetY(shot) < MIN_Y) {
                        ObjMove_SetAngle(shot, ReflectAngle(ObjMove_GetAngle(shot), 0));
                        ObjMove_SetY(shot, -ObjMove_GetY(shot));
                    }
                }
            }
            yield;
        }
    }

    float x = Boss_X(_objBoss);
    float y = Boss_Y(_objBoss) - 2;
    for (int i = 0; i < way; i++) {
        if (!Boss_Alive(_objBoss)) return;
        float sMod1 = rand(-sMod, sMod);
        int color = sMod1 > 0 ? SHOT_YELLOW : SHOT_ORANGE;
        shots ~= [CreateShotUA1(x + 14, y, speed + sMod1, 270 + angleT + rand(-arc, arc), color+SPARKLE, 0, color+SPAWN_S+SIZE_8, color+CANCEL_BURST1)];
        shots ~= [CreateShotUA1(x - 14, y, speed + sMod1, 270 - angleT + rand(-arc, arc), color+SPARKLE, 0, color+SPAWN_S+SIZE_8, color+CANCEL_BURST1)];
        CallSFX(SND_SHOT2);
        wait(waitTime);
    }

    if (!Boss_Alive(_objBoss)) return;
    Animation_Charge(_objBoss, false);
    Gengetsu_MoveRandom(_objBoss, 130, 16, 60);

}

task TChargeAnim() {
    Primitive_ContractPolygon2D(_objBoss, 0, 368, 0, 45, 32, COLOR_WHITE, false, RP_STG_EFF_MID);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_WHITE);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_WHITE);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_PINK);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_PINK);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_PURPLE_L);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_PURPLE_L);
}