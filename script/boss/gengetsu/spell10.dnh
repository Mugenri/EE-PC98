#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Spell 10"]
#System["./../../system/System.dnh"]

#include "./lib_Gengetsu.dnh"

int _objBoss;
int _count = -30;
int _loopTime = 300;
_spellID = 9;

@Event {
    alternative (GetEventType())
    case (EV_REQUEST_LIFE) {
        SetScriptResult(3500);
    }
    case (EV_REQUEST_TIMER) {
        SetScriptResult(60 + absolute(_count / 60));
    }
}

@Initialize {
    Boss_Init(false);
    _objBoss = Boss_Create(BOSS_ID_GENGETSU);
    TInitialize();
    TFinalize();
    TMain();
}

@MainLoop {
    Boss_Update(_objBoss);
    _count++;
    yield;
}

task TInitialize() {
    Gengetsu_Init(_objBoss);
    if (GetGameMode() == GAME_SPELL) Gengetsu_Move(_objBoss, MID_X, MID_Y, 30);
    wait(30);
    TRage();
    TLasers();
    TRing();
    wait(410);
    Boss_SetVulnerable(_objBoss, true);
}

task TFinalize() {
    while (Boss_Alive(_objBoss)) yield;
    Gengetsu_Move(_objBoss, MID_X, MID_Y, 60);
    Animation_Charge(_objBoss, false);
    Boss_Finalize(_objBoss);
}

task TMain() {
    while (_count < -30) yield;
    while (Boss_Alive(_objBoss)) {
        if (!_isInvuln) Boss_SetIntersection(_objBoss, _intersectionShot, 0);
        yield;
    }
}

task TRing() {
    while (ObjEnemyBossScene_GetInfo(_objScene, INFO_ACTIVE_STEP_TOTAL_LIFE) > 2250) yield;

    TChargeAnim();
    CallSFX(SND_CHARGE1);
    wait(45);
    if (!Boss_Alive(_objBoss)) return;

    int dir = 1;
    int way = 12;
    int waitTime = 45;
    float rad = 48;
    float speed = 1.2;
    float accel = 0.05;
    float aMod = 120;

    while (Boss_Alive(_objBoss)) {
        float angle = rand(0, 360);
        for (int i = 0; i < way; i++) {
            CreateShotUA2(MID_X + rad * cos(angle), MID_Y + rad * sin(angle), 0, angle + aMod * dir, accel, speed, 0, SHOT_ORANGE+PILL_L, 0, SHOT_ORANGE+SPAWN_S+SIZE_32, SHOT_ORANGE+CANCEL_32);
            angle += 360 / way;
        }
        CallSFX(SND_SHOT1);
        dir *= -1;
        wait(waitTime);
    }
}

task TLasers() {
    //cross lasers
    //move every waitTime frames
    if (!Boss_Alive(_objBoss)) return;
    Animation_Charge(_objBoss, true);
    CallSFX(SND_CHARGE1);
    TChargeAnim();
    wait(45);
    if (!Boss_Alive(_objBoss)) return;

    int waitTime = 520;
    loop (4) {
        TLaser();
        wait(waitTime / 4);
    }

    task TLaser() {
        int count = 0;
        int delay = 120;
        int rad = 16;
        float x = MID_X;
        float y = MID_Y;
        float angle = 0;
        float inc = 360 / waitTime;
        int moveTime = waitTime / 4;
        int shotTime = waitTime / 6;
        int way = 10;

        int laser = CreateStraightLaserUA1(x, y, angle, 450, 5000, COLOR_PINK, delay);
        async {
            CallSFX(SND_CHARGE1);
            wait(delay);
            CallSFX(SND_LASER1);
        }
        while (Boss_Alive(_objBoss)) {
            if (count % (waitTime / 2) == waitTime / 4 + 45) { //move
                float x1 = x;
                float y1 = y;
                float x2 = Interpolate_Linear(MID_X, GetPlayerX(), 80 / 100.0);
                float y2 = Interpolate_Linear(MID_Y, GetPlayerY(), 80 / 100.0);
                async {
                    for (int i = 0; i < moveTime; i++) {
                        if (!Boss_Alive(_objBoss)) return;
                        x = Interpolate_Decelerate(x1, x2, i / as_float(moveTime - 1));
                        y = Interpolate_Decelerate(y1, y2, i / as_float(moveTime - 1));
                        yield;
                    }
                }
                CallSFX(SND_SHOT2);
            }
            if (count % shotTime == shotTime - 1) { //shot
                async {
                    float xPos = ObjMove_GetX(laser);
                    float yPos = ObjMove_GetY(laser);
                    float angleT = ObjStLaser_GetAngle(laser) - 90;
                    float accel = 0.01;
                    float speed = 1.3;
                    float wvel = -3;
                    for (int i = 0; i < way; i++) {
                        int shot1 = CreateShotUA2(xPos, yPos, 0.5, angleT, accel, speed, wvel, SHOT_YELLOW_INV+BALL_SS, 0, SHOT_YELLOW_INV+SPAWN_S+SIZE_8, SHOT_YELLOW_INV+CANCEL_BURST1);
                        int shot2 = CreateShotUA2(xPos, yPos, 0.5, angleT, accel, speed, wvel, SHOT_YELLOW+BEAM, 5, SHOT_YELLOW+SPAWN_S+SIZE_8, SHOT_YELLOW+CANCEL_BURST1);
                        ObjMove_AddPatternA2(shot1, 60, NO_CHANGE, NO_CHANGE, NO_CHANGE, NO_CHANGE, 0);
                        ObjMove_AddPatternA2(shot2, 60, NO_CHANGE, NO_CHANGE, NO_CHANGE, NO_CHANGE, 0);
                        angleT += 180 / (way - 1);
                    }
                    CallSFX(SND_SHOT1);
                }
            }
            //angles
            ObjMove_SetPosition(laser, x + rad * cos(angle), y + rad * sin(angle));
            ObjStLaser_SetAngle(laser, angle + 180);
            angle += inc;
            count++;
            yield;
        }
        ObjShot_SetDeleteFrame(laser, 0);
    }
}

task TChargeAnim() {
    Primitive_ContractPolygon2D(_objBoss, 0, 368, 0, 45, 32, COLOR_WHITE, false, RP_STG_EFF_MID);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_WHITE);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_WHITE);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_PINK);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_PINK);
    wait(2);
    Particle_ContractRing(_objBoss, 0, 368, 135, 45, 16, COLOR_YELLOW_L);
    Particle_ContractRing(_objBoss, 0, 368, -135, 45, 16, COLOR_YELLOW_L);
}