#TouhouDanmakufu[Single]
#ScriptVersion[3]
#Title["Spell 18"]
#System["./../../system/System.dnh"]

#include "./lib_Gengetsu.dnh"

int _objBoss;
int _count = -180;
int _loopTime = 1000;
float _life = 7000;
_spellID = 17;

@Event {
    alternative (GetEventType())
    case (EV_REQUEST_LIFE) {
        SetScriptResult(7000);
    }
    case (EV_REQUEST_TIMER) {
        SetScriptResult(60 + absolute(_count / 60));
    }
}

@Initialize {
    Boss_Init(false);
    _objBoss = Boss_Create(BOSS_ID_GENGETSU);
    TInitialize();
    TFinalize();
    TMain();
}

@MainLoop {
    Boss_Update(_objBoss);
    _count++;
    yield;
}

task TInitialize() {
    Gengetsu_Init(_objBoss);
    if (GetGameMode() == GAME_SPELL) Gengetsu_Move(_objBoss, MID_X, 80, 30);
    wait(30);
    TIntro();
    wait(150);
    Boss_SetVulnerable(_objBoss, true);
    TRage();
    TSpell();
}

task TFinalize() {
    while (Boss_Alive(_objBoss)) yield;
    if (GetGameMode() == GAME_SPELL) {
        Animation_Special(_objBoss, false);
        Gengetsu_Move(_objBoss, MID_X, 60, 60);
    }
    Boss_Finalize(_objBoss);
}

task TMain() {
    while (_count < -30) yield;
    while (Boss_Alive(_objBoss)) {
        if (!_isInvuln) {
            Boss_SetIntersection(_objBoss, _intersectionShot, 0);
            ObjEnemy_SetIntersectionCircleToShot(_objBoss, ObjMove_GetX(_objBoss) - 36, ObjMove_GetY(_objBoss) - 8, _intersectionShot / 2);
            ObjEnemy_SetIntersectionCircleToShot(_objBoss, ObjMove_GetX(_objBoss) + 36, ObjMove_GetY(_objBoss) - 8, _intersectionShot / 2);
        }
        _life = ObjEnemyBossScene_GetInfo(_objScene, INFO_ACTIVE_STEP_TOTAL_LIFE);
        yield;
    }
}

task TSpell() {
    wait(30);

    TPattern2();
    wait(120);
    TPattern3();
    wait(60);
    TPattern1();

    task TPattern1() { //aimed balls
        float xRange = MID_X - 30;
        float yRange = 16;
        float speed = 4;
        int waitTime = 30;
        while (Boss_Alive(_objBoss)) {
            float x = MID_X + rand(-xRange, xRange);
            float y = Boss_Y(_objBoss) + rand(-yRange, yRange) - 8;
            CreateShotUA1(x, y, speed, dottheta(x, y, GetPlayerX(), GetPlayerY()), SHOT_PINK_INV+BALL_L, 0, SHOT_PINK+SPAWN_S+SIZE_32, SHOT_PINK_INV+CANCEL_32);
            CallSFX(SND_SHOT3);
            if (_life < 3000) waitTime = 20;
            wait(waitTime);
        }
    }

    task TPattern2() { //scale waves

        int frames = 120;
        float x1 = 16;
        float x2 = 64;
        float speed = 5;
        float angle = 0;
        float arc = 80;
        int waitTime = 4;

        int i = 0;
        while (Boss_Alive(_objBoss)) {
            float y = Boss_Y(_objBoss);
            angle = 20 * (sin(360 / frames * i)) + 65;
            //down
            CreateShotUA1(MID_X + x1, y - 3, speed, angle, SHOT_RED+SCALE, 0, SHOT_RED+SPAWN_E+SIZE_16, SHOT_RED+CANCEL_BURST1);
            CreateShotUA1(MID_X - x1, y - 3, speed, -angle + 180, SHOT_RED+SCALE, 0, SHOT_RED+SPAWN_E+SIZE_16, SHOT_RED+CANCEL_BURST1);
            CreateShotUA1(MID_X + x2, y - 18, speed, angle, SHOT_RED_INV+SCALE, 0, SHOT_RED_INV+SPAWN_S+SIZE_16, SHOT_RED_INV+CANCEL_BURST1);
            CreateShotUA1(MID_X - x2, y - 18, speed, -angle + 180, SHOT_RED_INV+SCALE, 0, SHOT_RED_INV+SPAWN_S+SIZE_16, SHOT_RED_INV+CANCEL_BURST1);
            //white
            CreateShotUA1(MID_X + x1, y - 3, speed, angle + 180, SHOT_WHITE+PELLET, 0, SHOT_WHITE+SPAWN_E+SIZE_8, SHOT_WHITE+CANCEL_BURST1);
            CreateShotUA1(MID_X - x1, y - 3, speed, -angle, SHOT_WHITE+PELLET, 0, SHOT_WHITE+SPAWN_E+SIZE_8, SHOT_WHITE+CANCEL_BURST1);
            CreateShotUA1(MID_X + x2, y - 18, speed, angle + 180, SHOT_WHITE+PELLET, 0, SHOT_WHITE+SPAWN_S+SIZE_8, SHOT_WHITE+CANCEL_BURST1);
            CreateShotUA1(MID_X - x2, y - 18, speed, -angle, SHOT_WHITE+PELLET, 0, SHOT_WHITE+SPAWN_S+SIZE_8, SHOT_WHITE+CANCEL_BURST1);
            if (i > 30) {
                //right
                CreateShotUA1(MID_X + x1, y - 3, speed, angle - arc, SHOT_RED+SCALE, 0, SHOT_RED+SPAWN_E+SIZE_16, SHOT_RED+CANCEL_BURST1);
                CreateShotUA1(MID_X - x1, y - 3, speed, -angle + 180 - arc, SHOT_RED+SCALE, 0, SHOT_RED+SPAWN_E+SIZE_16, SHOT_RED+CANCEL_BURST1);
                CreateShotUA1(MID_X + x2, y - 18, speed, angle - arc, SHOT_RED_INV+SCALE, 0, SHOT_RED_INV+SPAWN_S+SIZE_16, SHOT_RED_INV+CANCEL_BURST1);
                CreateShotUA1(MID_X - x2, y - 18, speed, -angle + 180 - arc, SHOT_RED_INV+SCALE, 0, SHOT_RED_INV+SPAWN_S+SIZE_16, SHOT_RED_INV+CANCEL_BURST1);
                //left
                CreateShotUA1(MID_X + x1, y - 3, speed, angle + arc, SHOT_RED+SCALE, 0, SHOT_RED+SPAWN_E+SIZE_16, SHOT_RED+CANCEL_BURST1);
                CreateShotUA1(MID_X - x1, y - 3, speed, -angle + 180 + arc, SHOT_RED+SCALE, 0, SHOT_RED+SPAWN_E+SIZE_16, SHOT_RED+CANCEL_BURST1);
                CreateShotUA1(MID_X + x2, y - 18, speed, angle + arc, SHOT_RED_INV+SCALE, 0, SHOT_RED_INV+SPAWN_S+SIZE_16, SHOT_RED_INV+CANCEL_BURST1);
                CreateShotUA1(MID_X - x2, y - 18, speed, -angle + 180 + arc, SHOT_RED_INV+SCALE, 0, SHOT_RED_INV+SPAWN_S+SIZE_16, SHOT_RED_INV+CANCEL_BURST1);
                //white
                CreateShotUA1(MID_X + x1, y - 3, speed, angle - arc + 180, SHOT_WHITE+PELLET, 0, SHOT_WHITE+SPAWN_E+SIZE_16, SHOT_WHITE+CANCEL_BURST1);
                CreateShotUA1(MID_X - x1, y - 3, speed, -angle - arc, SHOT_WHITE+PELLET, 0, SHOT_WHITE+SPAWN_E+SIZE_16, SHOT_WHITE+CANCEL_BURST1);
                CreateShotUA1(MID_X + x2, y - 18, speed, angle - arc + 180, SHOT_WHITE+PELLET, 0, SHOT_WHITE+SPAWN_S+SIZE_16, SHOT_WHITE+CANCEL_BURST1);
                CreateShotUA1(MID_X - x2, y - 18, speed, -angle - arc, SHOT_WHITE+PELLET, 0, SHOT_WHITE+SPAWN_S+SIZE_16, SHOT_WHITE+CANCEL_BURST1);
                CreateShotUA1(MID_X + x1, y - 3, speed, angle + arc + 180, SHOT_WHITE+PELLET, 0, SHOT_WHITE+SPAWN_E+SIZE_16, SHOT_WHITE+CANCEL_BURST1);
                CreateShotUA1(MID_X - x1, y - 3, speed, -angle + arc, SHOT_WHITE+PELLET, 0, SHOT_WHITE+SPAWN_E+SIZE_16, SHOT_WHITE+CANCEL_BURST1);
                CreateShotUA1(MID_X + x2, y - 18, speed, angle + arc + 180, SHOT_WHITE+PELLET, 0, SHOT_WHITE+SPAWN_S+SIZE_16, SHOT_WHITE+CANCEL_BURST1);
                CreateShotUA1(MID_X - x2, y - 18, speed, -angle + arc, SHOT_WHITE+PELLET, 0, SHOT_WHITE+SPAWN_S+SIZE_16, SHOT_WHITE+CANCEL_BURST1);
            }
            CallSFX(SND_SHOT1);
            i++;
            if (i % frames == 50) TLaser();

            wait(waitTime);

            task TLaser() {
                int sustain = 120;
                int delay = 120;
                CallSFX(SND_CHARGE1);
                int laser = CreateMasterSpark(MID_X, Boss_Y(_objBoss) - 3, 90, MAX_Y, 96, sustain, COLOR_BLUE, COLOR_INDIGO_L, delay);

                async {
                    int l1 = Laser_WarningLine(MID_X, Boss_Y(_objBoss), 90, 400, delay);
                    int l2 = Laser_WarningLine(MID_X, Boss_Y(_objBoss), 90, 400, delay);

                    for (int i = 0; i < delay; i++) {
                        if (!Boss_Alive(_objBoss)) break;
                        int xMod = Interpolate_Decelerate(0, 96 / 2, i / as_float(delay));
                        ObjPrim_SetVertexPosition(l1, 1, MID_X + xMod, 400, 1);
                        ObjPrim_SetVertexPosition(l2, 1, MID_X - xMod, 400, 1);
                        yield;
                    }
                    if (!Obj_IsDeleted(l1)) Obj_Delete(l1);
                    if (!Obj_IsDeleted(l2)) Obj_Delete(l2);
                }

                wait(delay);
                if (!Boss_Alive(_objBoss)) return;
                CallSFX(SND_MASTERSPARK);

                for (int i = 0; i < sustain; i++) {
                    if (!Boss_Alive(_objBoss)) return;
                    ObjMove_SetY(laser, Boss_Y(_objBoss) - 3);
                }
            }
        }
    }

    task TPattern3() { //momoyo non
        //two circles of way with accelerations speed + (i % stack) / stack * max

        int way = 25;
        int stack = 5;
        int rad = 32;
        float speed = 4;
        float angle = 0;
        float arc = 12.3;
        float minAccel = 0.01;
        float maxAccel = 0.2;
        int waitMin = 15;
        int waitMax = 30;
        int waitTime = waitMax;

        while (Boss_Alive(_objBoss)) {
            for (int i = 0; i < way; i++) {
                float y = Boss_Y(_objBoss) - 4;
                float accel = minAccel + (i % stack) / (stack - 1) * maxAccel;
                int shot1 = CreateShotUA2(MID_X + rad * cos(angle), y + rad * sin(angle), 0, angle, accel, speed, 0, SHOT_YELLOW+BALL_SS, 0, SHOT_YELLOW+SPAWN_S+SIZE_8, SHOT_YELLOW+CANCEL_SPARKLE);
                int shot2 = CreateShotUA2(MID_X + rad * cos(-angle + 180), y + rad * sin(-angle + 180), 0, -angle + 180, accel, speed, 0, SHOT_YELLOW+BALL_SS, 0, SHOT_YELLOW+SPAWN_S+SIZE_8, SHOT_YELLOW+CANCEL_SPARKLE);
                ObjMove_AddPatternA2(shot1, 40 + (i % stack) * 3, NO_CHANGE, NO_CHANGE, -1, 2, 0);
                ObjMove_AddPatternA2(shot2, 40 + (i % stack) * 3, NO_CHANGE, NO_CHANGE, -1, 2, 0);
                angle += 360 / way;
            }
            angle += arc;
            CallSFX(SND_SHOT2);
            waitTime = Interpolate_Linear(waitMin, waitMax, _life / 7000.0);
            if (_life < 400) waitTime = 4;
            wait(waitTime);
        }
    }
}

task TIntro() {
    //intro animation
    yield;
    CallSFX(SND_CHARGE1);
    float x = Boss_X(_objBoss);
    float y = Boss_Y(_objBoss);
    int frames = 120;
    float angle = 90 + 90 / frames;

    loop (3) {
        TLaser(angle, frames);
        angle += 8;
    }
    //white flash
    int white = InitSprite2D(0, 0, MAX_X, MAX_Y, RP_STG_EFF_MAX);
    ObjRender_SetColor(white, COLOR_WHITE);
    for (int i = 0; i < frames; i++) {
        ObjRender_SetAlpha(white, Interpolate_Linear(0, 180, i / as_float(frames)) - i % 16);
        yield;
    }
    Obj_Delete(white);
    Transition_ChangeBG(2, 0);
    
    CallSFX(SND_SHOT1);
    CallSFX(SND_LASER1);
    Animation_Special(_objBoss, true);
    TFloat();

    //shake
    for (int i = 0; i < 8; i++) {
        Set2DCameraFocusX(MID_X + (prand_int(0, 1) == 0 ? 1 : -1) * 4 - (i / 32));
        Set2DCameraFocusY(MID_Y + (prand_int(0, 1) == 0 ? 1 : -1) * 4 - (i / 32));
        yield;
    }
    Set2DCameraFocusX(MID_X);
    Set2DCameraFocusY(MID_Y);

    task TLaser(float angle_, int frames_) {
        int laser1 = CreateStraightLaserUA1(x, y, angle_, 400, 16, COLOR_BLUE, frames_);
        int laser2 = CreateStraightLaserUA1(x, y, angle_, 400, 16, COLOR_BLUE, frames_);
        int rad = 16;
        loop (frames_) {
            ObjMove_SetPosition(laser1, x + rad * cos(angle_), y + rad * sin(angle_));
            ObjMove_SetPosition(laser2, x + rad * cos(-angle_ + 180), y + rad * sin(-angle_ + 180));
            ObjStLaser_SetAngle(laser1, angle_);
            ObjStLaser_SetAngle(laser2, -angle_ + 180);
            angle_ += 90 / frames;
            yield;
        }
    }
}

task TFloat() {
    //up down floaty
    int count = 0;
    loop {
        if (!Boss_Alive(_objBoss) && GetGameMode() == GAME_SPELL) return;
        ObjMove_SetY(_objBoss, 80 + 8 * sin(count));
        count++;
        yield;
    }
}