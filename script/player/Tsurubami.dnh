#TouhouDanmakufu[Player]
#ScriptVersion[3]
#Title["Tsurubami Senri"]
#ID["Tsurubami"]
#Text["Inexplicable Hakama"]
#ReplayName["Tsurubami"]

#include "./lib/lib_player.dnh"

int _count = -1;
int _countShot = 0;

@Initialize {
    string imageFile = IMG_PLR_TSURUBAMI;
    string shotData = DIR_PLR ~ "TsuruShot.dnh";
    InitPlayer(imageFile, shotData, 4.0, 1.9, 16, 64);

    TShot();
    TOption(1);
    TOption(-1);
}

@MainLoop {
    if (Shooting() && !IsPlayerSpellActive() && Alive()) _count++;
    else if (_count >= 0 && _count % 16 != 15) _count++;
    else _count = -1;
    if (Alive()) SetPlayerItemScope(GetVirtualKeyState(VK_SLOWMOVE) == KEY_HOLD ? _focusScope : _itemScope);
    yield;
}

@Event { PlayerEvent(); }

@Finalize {}

task TShot() { //main shot
    float damage = 2;
    loop {
        if (!IsPlayerSpellActive() && Alive() && _count % 10 == 0) {
            loop (3) {
                int offsetX = 8;
                int shot = CreatePlayerShotA1(GetPlayerX() - offsetX - 1, GetPlayerY() + 14, 28, 270, damage, 1, 1);
                int shot2 = CreatePlayerShotA1(GetPlayerX() + offsetX, GetPlayerY() + 14, 28, 270, damage, 1, 1);
                ObjRender_SetScaleX(shot2, -1);
                Obj_SetRenderPriorityI(shot, RP_STG_PLAYER);
                Obj_SetRenderPriorityI(shot2, RP_STG_PLAYER);
                CallSFX(SND_PL_SHOT);
                wait(3);
            }
        }
        yield;
    }
}

task TOption(int dir_) {
    int objOption = InitSprite2D(64, 48, 80, 64, _pathImg, RP_STG_PLAYER);
    ObjSprite2D_SetDestCenter(objOption);

    TOptionShot();

    int dist = 24;
    int frame = 0;
    int frames = 4 * 6;
    loop {
        int temp = frame ~/ 6 * 16;
        ObjRender_SetPosition(objOption, GetPlayerX() + dist * dir_, GetPlayerY(), 1);
        ObjSprite2D_SetSourceRect(objOption, 48 + temp, 48, 48 + 16 + temp, 64);
        ObjSprite2D_SetDestCenter(objOption);
        frame++;
        frame %= frames;
        yield;
    }

    task TOptionShot() {
        float speed = 2;
        float optionDamage = 4.8;
        float xAccel = 0.12;
        float yAccel = -0.6;
        float xSpeedMax = 1.5;
        float ySpeed = -8;
        loop {
            if (Alive() && !IsPlayerSpellActive() && _count % 16 == 0) {
                float optionX = ObjRender_GetX(objOption);
                float optionY = ObjRender_GetY(objOption);

                int shot1 = CreatePlayerShotA1(optionX, optionY, speed, 90 + 72 * dir_ - 72 * 0 * dir_, optionDamage, 1, 2);
                int shot2 = CreatePlayerShotA1(optionX, optionY, speed, 90 + 72 * dir_ - 72 * 1 * dir_, optionDamage, 1, 2);
                int shot3 = CreatePlayerShotA1(optionX, optionY, speed, 90 + 72 * dir_ - 72 * 2 * dir_, optionDamage, 1, 2);
                int shot4 = CreatePlayerShotA1(optionX, optionY, speed, 90 + 72 * dir_ - 72 * 3 * dir_, optionDamage, 1, 2);
                int shot5 = CreatePlayerShotA1(optionX, optionY, speed, 270, optionDamage, 1, 2);
                int shot6 = CreatePlayerShotA1(optionX, optionY, speed + 4, 270, optionDamage, 1, 2);

                ObjMove_AddPatternB2(shot1, 10, NO_CHANGE, NO_CHANGE, xAccel * dir_, yAccel, xSpeedMax * dir_, ySpeed);
                ObjMove_AddPatternB2(shot2, 10, NO_CHANGE, NO_CHANGE, 0, yAccel, 0, ySpeed);
                ObjMove_AddPatternB2(shot3, 10, NO_CHANGE, NO_CHANGE, (-xAccel - 0.12) * dir_, yAccel, -xSpeedMax * dir_, ySpeed);
                ObjMove_AddPatternB2(shot4, 10, NO_CHANGE, NO_CHANGE, 0, yAccel, 0, ySpeed);
                ObjMove_AddPatternB2(shot5, 10, NO_CHANGE, NO_CHANGE, 0, yAccel, 0, ySpeed);
                ObjMove_AddPatternB2(shot6, 10, NO_CHANGE, NO_CHANGE, 0, yAccel, 0, ySpeed);

                Obj_SetRenderPriorityI(shot1, RP_STG_EFF_PLR_LO);
                Obj_SetRenderPriorityI(shot2, RP_STG_EFF_PLR_LO);
                Obj_SetRenderPriorityI(shot3, RP_STG_EFF_PLR_LO);
                Obj_SetRenderPriorityI(shot4, RP_STG_EFF_PLR_LO);
                Obj_SetRenderPriorityI(shot5, RP_STG_EFF_PLR_LO);
                Obj_SetRenderPriorityI(shot6, RP_STG_EFF_PLR_LO);
            }
            yield;
        }
    }
}

task TShotCancel(int obj_, float x_, float y_, int graphic_) { //Player shot deletion effect
    float angle = ObjMove_GetAngle(obj_);
    float speed = 5 - graphic_ * 2;
    float xStep = speed * cos(angle);
    float yStep = speed * sin(angle);
    float angleZ = ObjRender_GetAngleZ(obj_);
    float scaleX = ObjRender_GetScaleX(obj_);
    if (rand_int(1, 8) == 1) TShotParticle(x_, y_);
    
    int frame = 0;
    int frameRate = 2 * graphic_;
    while (frame < 4 * frameRate) {
        ObjParticleList_SetPosition(_particleShot, x_, y_, 1);
        ObjParticleList_SetAngleZ(_particleShot, angleZ);
        ObjParticleList_SetScaleX(_particleShot, scaleX);
        ObjParticleList_SetExtraData(_particleShot, graphic_ + 6 + frame / frameRate, graphic_ - 1, 0);
        ObjParticleList_AddInstance(_particleShot);

        frame++;
        x_ += xStep;
        y_ += yStep;
        yield;
    }
}

task TSpell() {
    int objManage = GetSpellManageObject();

    SetForbidPlayerShot(true);
    SetPlayerInvincibilityFrame(240);
    ObjRender_SetColor(_objPlayer, COLOR_WHITE);
    SetPlayerSpeed(2.0, 2.0);

    TEffect();
    
    //spell time
    wait(180);

    SetForbidPlayerSpell(true);
    SetForbidPlayerShot(false);
    SetPlayerSpeed(4.5, 2.0);
    Obj_Delete(objManage);
    wait(40);

    //vulnerability indicator
    CallSFX(SND_PL_VULNERABLE);
    SetForbidPlayerSpell(false);
    float radius = 28;
    int circle = InitPrim2D(PRIMITIVE_LINESTRIP, 17, RP_STG_EFF_PLR_HI);
    ObjRender_SetColor(circle, COLOR_ICE);
    loop (20) {
        ascent (i in 0..17) {
            float angleT = 360 / 16 * i;
            ObjPrim_SetVertexPosition(circle, i, GetPlayerX() + radius * cos(angleT), GetPlayerY() + radius * sin(angleT), 1);
        }
        radius -= 28 / 20;
        yield;
    }

    Obj_Delete(circle);

    task TEffect() {
        int flash = InitSprite2D(0, 0, MAX_X, MAX_Y, RP_STG_EFF_MAX);
        CallSFX(SND_PL_SPELL);

        int frames = 20;
        for (int i = 1; i <= frames; i++) {
            ObjRender_SetAlpha(flash, 196 / 14 * as_int(Interpolate_Linear(14, 0, i / as_float(frames))));
            yield;
        }

        //charge
        int dir = -1;
        CallSFX(SND_PL_SPELL_T1);
        loop (12) {
            dir *= -1;
            Primitive_ContractPolygon2D(_objPlayer, 0, 550, 0, 45, 32, COLOR_GRAY_L, false, RP_STG_EFF_MID);
            yield;
            Particle_ContractRing(_objPlayer, 90, 550, 180 * dir, 45, 18, COLOR_WHITE);
            yield;
            Particle_ContractRing(_objPlayer, 90, 550, 180 * -dir, 45, 18, COLOR_BLACK);
            yield;
        }

        wait(45);

        int laser = ObjSpell_Create();
        ObjSpell_SetEraseShot(laser, true);
        ObjSpell_SetDamage(laser, 65);
        ObjSpell_Regist(laser);

        float hitboxLength = 0;
        float modifier = 0;
        loop (60) {
            TCreateLaserEffect(1);
            TCreateLaserEffect(-1);
            modifier += 360 / 14;
            ObjSpell_SetIntersectionLine(laser, GetPlayerX(), GetPlayerY(), GetPlayerX(), GetPlayerY() - hitboxLength, 44);
            hitboxLength += 28; //bullet speed
            CallSFX(SND_PL_SPELL_T2);
            yield;
        }
        Obj_Delete(laser);

        task TCreateLaserEffect(int direction_) {
            int shot1 = InitSprite2D(0, 48, 16, 64, _pathImg, RP_STG_PLAYER - 2i);
            ObjSprite2D_SetDestCenter(shot1);

            int shot2 = InitSprite2D(32, 48, 48, 64, _pathImg, RP_STG_PLAYER - 2i);
            ObjSprite2D_SetDestCenter(shot2);

            ObjRender_SetPosition(shot1, GetPlayerX() + 20 * direction_ * cos(modifier), GetPlayerY() + direction_ * 4, 1);
            ObjRender_SetPosition(shot2, GetPlayerX() + 15 * direction_ * cos(modifier + 90), GetPlayerY() + direction_ * 8, 1);
            loop (20) {
                ObjRender_SetY(shot1, ObjRender_GetY(shot1) - 28); //bullet speed
                ObjRender_SetY(shot2, ObjRender_GetY(shot2) - 28);
                yield;
            }
            Obj_Delete(shot1);
            Obj_Delete(shot2);
        }
    }
}